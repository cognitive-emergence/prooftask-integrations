{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.cognitive-emergence/prooftask",
  "title": "Prooftask",
  "description": "Free public n8n, AI support and software acceptance templates; scoped private delivery workflows.",
  "repository": {
    "url": "https://github.com/cognitive-emergence/prooftask-integrations",
    "source": "github"
  },
  "version": "0.1.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "prooftask-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://prooftask-public-mcp-production.up.railway.app/mcp"
    }
  ],
  "websiteUrl": "https://prooftask.com/developers",
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "publicTools": [
        "getAgentCapabilities",
        "searchPublicSpecifications",
        "getPublicSpecification"
      ],
      "publicDiscovery": {
        "price": 0,
        "currency": "USD",
        "credentialRequired": false
      },
      "servicePricingUrl": "https://prooftask.com/pricing",
      "chineseGuideUrl": "https://prooftask.com/zh",
      "price": "free",
      "tools": [
        "getAgentCapabilities",
        "searchPublicSpecifications",
        "getPublicSpecification"
      ],
      "pricingScope": "Hosted public MCP discovery and template reads only. Private delivery workflows and Result Records have separate service terms and pricing: https://prooftask.com/pricing"
    }
  }
}
